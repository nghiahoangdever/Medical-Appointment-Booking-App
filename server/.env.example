# SQLite file, relative to prisma/schema.prisma.
# connection_limit=1 makes transactions run one at a time (see src/db/prisma.ts).
DATABASE_URL="file:./dev.db?connection_limit=1"

PORT=4000
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="8h"
CLIENT_ORIGIN="http://localhost:5173"

# DEV ONLY: pretend the server's time is HH:mm today (time keeps running from there), to test
# shift-time rules at any hour. Leave empty for the real clock. Refused when NODE_ENV=production.
DEV_FAKE_NOW=""
