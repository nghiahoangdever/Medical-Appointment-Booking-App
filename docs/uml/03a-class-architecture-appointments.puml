@startuml
' MediSchedule: boundary / control / entity view of the server, part 1:
' login, booking, appointments and the doctor queue (part 2, administration: 03b).
' Layering: Controller -> Service -> Repository -> Prisma; domain/ is framework-free.
' Constructor dependencies match the singletons exported by each module.
' -right- / .left. links are layout hints only (same meaning as -->); they keep lines from crossing.

title MediSchedule: Server classes (1/2): booking, appointments, queue
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 60
hide empty attributes
hide empty fields
set separator none

package "middleware" <<Rectangle>> {
  class authenticate <<function>> {
    + authenticate(req, res, next)
  }
  class requireRole <<function>> {
    + requireRole(...roles: Role[])
  }
}

package "boundary (controllers)" <<Rectangle>> {
  class AuthController {
    + register()
    + login()
    + me()
  }
  class AvailabilityController
  class AppointmentController {
    + book()
    + listMine()
    + listForStaff()
    + cancel()
    + checkIn()
    + markNoShow()
    + start()
    + complete()
    + addNote()
  }
  class QueueController {
    + schedule()
    + queueForEntry()
    + callNext()
  }
}

package "control (services)" <<Rectangle>> {
  class AuthService {
    + registerPatient(input)
    + login(identifier, password)
    + getCurrentUser(userId)
  }
  class AvailabilityService {
    + getAvailability(specialtyId, doctorId?)
  }
  class BookingService {
    + book(patientId, req): AppointmentView
  }
  class AppointmentService {
    + listForPatient(patientId)
    + listForStaff(viewer, filter)
    + cancel(actor, id, reason?)
    + checkIn(actor, id)
    + markNoShow(actor, id)
    + start(actor, id)
    + complete(actor, id)
    + addNote(actor, id, content)
    - perform(actor, id, action, extraData)
    - findVisibleTo(actor, id, db?)
  }
  class QueueService {
    + getSchedule(doctor)
    + getQueue(doctor, rosterEntryId)
    + callNext(doctor, rosterEntryId)
    - ownEntry(doctor, rosterEntryId)
  }
  class AppointmentMapper <<module>> {
    + toAppointmentView(record, viewer, now)
    + toStaffAppointmentView(record, viewer, now)
    + toViewFor(record, viewer, now)
  }
}

package "entity access (repositories)" <<Rectangle>> {
  class UserRepository {
    + findById(id)
    + findByEmailOrPhone(identifier)
  }
  class SpecialtyRepository
  class DoctorRepository
  class ShiftRepository
  class RosterRepository {
    + findSlots(filter, db?)
    + takeNextQueueNumber(rosterEntryId, db?)
    + findDutyShifts(doctorUserId, from, to)
    + findDutyEntry(id)
  }
  class AppointmentRepository {
    + findById(id, db?)
    + findByPatient(patientId)
    + findForStaff(filter)
    + findByRosterEntry(rosterEntryId)
    + findFirstCheckedIn(rosterEntryId)
    + findDoctorInExamination(doctorUserId, date)
    + findActiveForPatientInSlot(patientId, date, shiftId, db?)
    + create(data, db?)
    + updateStatus(id, from, data, db?)
  }
  class NoteRepository
}

package "domain (no framework imports)" <<Rectangle>> {
  class BookingRules <<module>> {
    + bookingWindow(now)
    + pickLeastBooked(candidates)
    + generateAppointmentCode()
  }
  class AppointmentStateMachine <<module>> {
    + TRANSITIONS: Transition[]
    + transition(from, action, role): AppointmentStatus
    + availableActions(status, role): AppointmentAction[]
  }
  class AppointmentRules <<module>> {
    + guardFailure(facts, action, actor, now): AppError?
    + allowedActions(facts, actor, now): AppointmentAction[]
  }
  class AppError {
    + status: Int
    + code: String
  }
}

authenticate --> AuthService : getCurrentUser

AuthController --> AuthService
AvailabilityController --> AvailabilityService
AppointmentController --> BookingService
AppointmentController --> AppointmentService
QueueController --> QueueService

AuthService --> UserRepository

AvailabilityService --> SpecialtyRepository
AvailabilityService --> DoctorRepository
AvailabilityService --> RosterRepository

BookingService --> ShiftRepository
BookingService --> RosterRepository
BookingService --> AppointmentRepository
BookingService ..> BookingRules
BookingService ..> AppointmentStateMachine : INITIAL_STATUS

QueueService -right-> AppointmentService : start()
QueueService --> RosterRepository
QueueService --> AppointmentRepository

AppointmentService --> AppointmentRepository
AppointmentService --> NoteRepository
AppointmentService -right-> AppointmentMapper
AppointmentService ..> AppointmentStateMachine : transition()
AppointmentService ..> AppointmentRules : guardFailure()

AppointmentMapper ..> AppointmentRules : allowedActions()
AppointmentRules .left.> AppointmentStateMachine : availableActions()

legend bottom right
  Services throw AppError(status, code);
  time-dependent services receive a Clock
  (system clock, or a fixed clock in tests).
endlegend

@enduml
